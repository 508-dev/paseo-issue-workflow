{
  "id": "github-issue-workflow",
  "description": "Start Paseo workspaces from GitHub issues",
  "requirements": {
    "paseo": ">=0.16.0-beta.1"
  },
  "build": [
    [
      "npm",
      "ci",
      "--include=dev",
      "--legacy-peer-deps",
      "--ignore-scripts",
      "--no-audit",
      "--no-fund"
    ]
  ]
}
